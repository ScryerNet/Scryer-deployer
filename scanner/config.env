# config.env — sourced by scanner/scan.sh. Tune here, redeploy.

# --- What to scan ---
# Comma-separated ports for stage-1 masscan discovery.
PORTS="21,22,25,53,80,110,143,443,465,587,993,995,3306,3389,5432,6379,8080,8443"

# Address range. Default = all routable IPv4 (0.0.0.0/0 minus blocklist).
# For a first test, narrow this to a netblock you own, e.g. "203.0.113.0/24".
TARGETS="0.0.0.0/0"

# --- Speed (see README "Speed vs survival") ---
MASSCAN_RATE="25000"          # packets/sec for THIS vm's shard
MASSCAN_SRC_PORTS="40000-41000"  # must match the iptables RST-drop rule in setup-vm.sh

# --- Stage-2 fingerprinting toggles ---
DO_ZGRAB2="1"     # TLS certs, SSH host keys, HTTP banners
DO_JARM="1"       # active TLS server fingerprint (on 443/8443/465/993/995/...)
DO_ZDNS="1"       # reverse DNS (PTR) on every responsive host
ZGRAB2_SENDERS="500"   # concurrency for stage-2

# --- Responsible scanning ---
ABUSE_CONTACT="research@example.org"     # PUT A REAL ADDRESS HERE
SCAN_INFO_URL="https://scan.example.org" # page explaining the research + opt-out
BLOCKLIST="scanner/blocklist.conf"

# --- Results sync: GitHub only ---
# Each VM commits its results (summary + compressed, chunked raw) into
# results/vm<shard>/ and pushes straight to the INTEL repo (the results repo). No other backend.
#
# GIT_REPO_URL and GITHUB_TOKEN are NOT set here (keeps the token out of the repo).
# deploy.sh injects them into the environment when it launches the scan, reading
# them from YOUR shell. Create a fine-grained PAT with "Contents: Read and write"
# on the central repo and export it before deploying:
#   export GITHUB_TOKEN=github_pat_xxx
#   export GIT_REPO_URL=https://github.com/<you>/<intel-repo>.git
GIT_BRANCH="main"
GIT_AUTHOR_NAME="scanner"
GIT_AUTHOR_EMAIL="scanner@users.noreply.github.com"

# Keep every committed file safely under GitHub's 100 MB hard limit.
MAX_CHUNK_MB="90"
# Push in batches so no single push exceeds GitHub's 2 GB push limit
# (CHUNKS_PER_PUSH * MAX_CHUNK_MB must stay well under 2048 MB).
CHUNKS_PER_PUSH="15"
